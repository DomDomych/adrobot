# Docker Compose configuration. Never commit .env or a real API key.
POSTGRES_USER=adrobot
POSTGRES_DB=adrobot
POSTGRES_PASSWORD=change_me_local
APP_PORT=8080
KEITARO_API_URL=https://keitaro-for-tests.etolegko.com/admin_api/v1
KEITARO_ADMIN_URL=https://keitaro-for-tests.etolegko.com/admin/
KEITARO_API_KEY=
KEITARO_DOMAIN_ID=1813
KEITARO_GROUP_ID=10332
KEITARO_TRAFFIC_SOURCE_ID=836
KEITARO_TIMEOUT_SECONDS=15
# Optional external proxy; localhost/service traffic stays direct.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,backend,postgres
